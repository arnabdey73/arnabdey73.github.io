source "https://rubygems.org"

# Use GitHub Pages - this automatically includes the right version of Jekyll and supported plugins
gem "github-pages", group: :jekyll_plugins do
  gem "jekyll-remote-theme" # add if you want to use a remote theme
  gem "minima", "= 2.5.1"   # explicitly declare minima version to prevent conflicts
end

# Plugins supported by GitHub Pages
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
  gem "jekyll-seo-tag"
end

# For Ruby 3.0+ local development
gem "webrick", "~> 1.7"
